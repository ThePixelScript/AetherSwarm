#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "AetherSwarm 3D Robotics PoC - Autonomous Swarm Mission Simulation",
    "Authoritative multi-UAV spatial execution and verification environment."
  ]
  title "AetherSwarm Swarm Mission PoC"
  basicTimeStep 32
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.22 0.32 -0.92 1.85
  position 95 440 160
  near 0.5
  far 5000
}

# Ambient and Directional Lighting
DirectionalLight {
  direction 0.4 0.2 -0.9
  intensity 1.2
  castShadows TRUE
}

DirectionalLight {
  direction -0.5 -0.3 -0.8
  intensity 0.6
}

# Ground Plane (covers entire operational area plus GCS launch staging)
Solid {
  translation 500 500 -0.1
  name "terrain"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.88 0.90 0.92
        }
      }
      geometry Box {
        size 1300 1300 0.2
      }
    }
  ]
}

# 1000m x 1000m Operational Boundary Perimeter Line (z=0.2m)
Solid {
  translation 0 0 0
  name "operational_boundary"
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.2 0.2
          emissiveColor 0.6 0.1 0.1
        }
      }
      geometry IndexedLineSet {
        coord Coordinate {
          point [
            0 0 0.2,
            1000 0 0.2,
            1000 1000 0.2,
            0 1000 0.2,
            0 0 0.2,
            0 0 100,
            1000 0 100,
            1000 1000 100,
            0 1000 100,
            0 0 100
          ]
        }
        coordIndex [
          0, 1, 2, 3, 4, -1,
          5, 6, 7, 8, 9, -1,
          0, 5, -1,
          1, 6, -1,
          2, 7, -1,
          3, 8, -1
        ]
      }
    }
  ]
}

# Ground Control Station (GCS) at [-50.0, 500.0, 0.0]
DEF GCS Solid {
  translation -50 500 0
  name "gcs_base"
  children [
    # Main Helipad / Landing Staging Base
    Transform {
      translation 0 0 0.1
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.15 0.18 0.22
            }
          }
          geometry Box {
            size 24 24 0.2
          }
        }
      ]
    }
    # Landing Target Circle
    Transform {
      translation 0 0 0.22
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.9 0.7 0.1
            }
          }
          geometry Cylinder {
            height 0.04
            radius 9
          }
        }
      ]
    }
    # Inner Landing Mark
    Transform {
      translation 0 0 0.26
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.15 0.18 0.22
            }
          }
          geometry Cylinder {
            height 0.05
            radius 5
          }
        }
      ]
    }
    # GCS Command Communications Tower
    Transform {
      translation -8 -8 4
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.3 0.35 0.4
            }
          }
          geometry Box {
            size 3 3 8
          }
        }
      ]
    }
    # Tower Antenna Mast
    Transform {
      translation -8 -8 11
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.8 0.1 0.1
              emissiveColor 0.4 0.0 0.0
            }
          }
          geometry Cylinder {
            height 6
            radius 0.25
          }
        }
      ]
    }
  ]
}

# Dynamic RF Communication Mesh Links (Supervised via IndexedLineSet)
DEF COMM_LINKS Shape {
  appearance Appearance {
    material DEF COMM_MAT Material {
      diffuseColor 0.15 0.55 1.0
      emissiveColor 0.25 0.65 1.0
    }
  }
  geometry DEF COMM_LINES IndexedLineSet {
    coord DEF COMM_COORD Coordinate {
      point [
        -50 500 0.5,
        50 500 15.0
      ]
    }
    coordIndex [
      0, 1, -1
    ]
  }
}

# 5 Swarm Drone Instances (DEFs: UAV_1 .. UAV_5)
DEF UAV_1 Solid {
  translation 50 420 15
  rotation 0 0 1 0
  name "uav_1"
  children [
    Transform {
      scale 2.2 2.2 2.2
      children [
        Shape {
          appearance Appearance {
            material DEF UAV_1_MAT Material {
              diffuseColor 0.1 0.5 0.9
              emissiveColor 0.05 0.2 0.4
            }
          }
          geometry Box { size 0.9 0.9 0.25 }
        }
        # Rotor Hubs
        Transform { translation 0.75 0 0.05 children [ Shape { appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } } geometry Cylinder { height 0.06 radius 0.4 } } ] }
        Transform { translation -0.75 0 0.05 children [ Shape { appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } } geometry Cylinder { height 0.06 radius 0.4 } } ] }
        Transform { translation 0 0.75 0.05 children [ Shape { appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } } geometry Cylinder { height 0.06 radius 0.4 } } ] }
        Transform { translation 0 -0.75 0.05 children [ Shape { appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } } geometry Cylinder { height 0.06 radius 0.4 } } ] }
        # Status Beacon
        Transform { translation 0 0 0.25 children [ Shape { appearance Appearance { material DEF UAV_1_BEACON Material { diffuseColor 0.1 0.6 0.9 emissiveColor 0.1 0.6 0.9 } } geometry Sphere { radius 0.25 } } ] }
      ]
    }
  ]
}

