# Dedicated PoC Task for In-Flight Recovery Demo (poi_recovery)
DEF POI_RECOVERY Solid { translation 80 420 0 name "poi_recovery" children [
  Transform { translation 0 0 0.06 children [ Shape { appearance Appearance { material DEF POI_REC_MAT Material { diffuseColor 0.85 0.7 0.1 emissiveColor 0.2 0.15 0.0 } } geometry Cylinder { height 0.09 radius 2.5 } } ] }
  Transform { translation 0 0 1.2 children [ Shape { appearance Appearance { material Material { diffuseColor 0.3 0.3 0.3 } } geometry Cylinder { height 2.2 radius 0.14 } } ] }
  Transform { translation 0 0 2.4 children [ Shape { appearance Appearance { material DEF POI_REC_BEACON Material { diffuseColor 0.85 0.7 0.1 emissiveColor 0.6 0.5 0.05 } } geometry Sphere { radius 0.6 } } ] }
] }

# Supervisor Robot Node executing the authoritative trace consumer controller
DEF SUPERVISOR Robot {
  translation 0 0 0
  name "aetherswarm_supervisor"
  supervisor TRUE
  controller "aetherswarm_supervisor"
  children [
    # Mission Overview Recording Camera (1080p compatible)
    Camera {
      translation 120 380 90
      rotation 0.25 0.35 -0.90 1.80
      name "mission_camera"
      width 1920
      height 1080
      fieldOfView 1.1
    }
    # Operational Cluster Overhead Camera
    Camera {
      translation 60 500 120
      rotation 0 1 0 1.5708
      name "overhead_camera"
      width 1920
      height 1080
      fieldOfView 0.95
    }
  ]
}
