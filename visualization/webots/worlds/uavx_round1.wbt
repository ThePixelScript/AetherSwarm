  Transform { translation 0 0 0.05 children [ Shape { appearance Appearance { material DEF POI_01_MAT Material { diffuseColor 0.85 0.7 0.1 emissiveColor 0.2 0.15 0.0 } } geometry Cylinder { height 0.08 radius 2.2 } } ] }
